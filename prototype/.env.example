# Database
# Local development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/weather.db
# Production (PostgreSQL - Render will auto-populate this)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# CORS
# Local development
CORS_ORIGINS=*
# Production (comma-separated, no spaces)
# CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com

# App
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# Echo every SQL statement. Off by default — under continuous ingestion this
# floods the console and hides real errors. Turn on only to debug a query.
SQL_ECHO=false
# Auto-restart on code changes. Off by default: this service holds a background
# ingestion task and live WebSocket clients, so a reload interrupts the demo.
RELOAD=false

# ML Models
USE_MOCK_MODELS=true
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.60

# Real-time
WS_PING_INTERVAL=20
