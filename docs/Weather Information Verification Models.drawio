        <!-- Input Data Source -->
        <mxCell id="input" value="Citizen Weather Reports&#xa;(Text + Images + Metadata)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="280" height="85" as="geometry" />
        </mxCell>

        <!-- Pipeline Header -->
        <mxCell id="pipeline-label" value="ML/AI Verification Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="600" y="215" width="400" height="35" as="geometry" />
        </mxCell>

        <!-- Model 1: Fake News Detection -->
        <mxCell id="model1" value="1. Fake News Detection Model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="140" y="280" width="300" height="240" as="geometry" />
        </mxCell>
        <mxCell id="model1-details" value="Base Model: DistilBERT&#xa;Training Data: 50,000 labeled reports&#xa;&#xa;Metrics:&#xa;• Accuracy: 94.2%&#xa;• Precision: 0.93&#xa;• Recall: 0.92&#xa;• F1-Score: 0.93&#xa;• AUC-ROC: 0.97&#xa;• Inference: 45ms per text" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="150" y="320" width="280" height="190" as="geometry" />
        </mxCell>

        <!-- Model 2: Event Classification -->
        <mxCell id="model2" value="2. Event Classification Model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="280" width="300" height="240" as="geometry" />
        </mxCell>
        <mxCell id="model2-details" value="Architecture: CNN + LSTM hybrid&#xa;Classes: 7 weather events&#xa;&#xa;Metrics:&#xa;• F1 (macro): 0.89&#xa;• F1 (weighted): 0.91&#xa;• Top-1 Accuracy: 87%&#xa;• Rainfall: 0.92, Flooding: 0.89&#xa;• Heatwave: 0.88, Thunder: 0.90&#xa;• Fog: 0.85, Dust: 0.87, Wind: 0.91" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="490" y="320" width="280" height="190" as="geometry" />
        </mxCell>

        <!-- Model 3: Duplicate Detection -->
        <mxCell id="model3" value="3. Duplicate Detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="280" width="300" height="240" as="geometry" />
        </mxCell>
        <mxCell id="model3-details" value="Algorithm: MinHash + LSH&#xa;&#xa;Metrics:&#xa;• Precision: 0.96&#xa;• Recall: 0.91&#xa;• F1-Score: 0.93&#xa;• Speed: 10,000 docs/sec&#xa;• Memory: 95% reduction vs brute-force&#xa;• Redundancy Removal: 70%" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="830" y="320" width="280" height="190" as="geometry" />
        </mxCell>

        <!-- Model 4: Image Forensics -->
        <mxCell id="model4" value="4. Image Forensics Model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="280" width="300" height="240" as="geometry" />
        </mxCell>
        <mxCell id="model4-details" value="Technique: ELA + CNN&#xa;&#xa;Metrics:&#xa;• Accuracy: 91%&#xa;• False Positive Rate: 4.2%&#xa;&#xa;Purpose:&#xa;Detects manipulated/edited images&#xa;in weather reports to ensure&#xa;real-ground evidence." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1170" y="320" width="280" height="190" as="geometry" />
        </mxCell>

        <!-- Model 5: Source Credibility -->
        <mxCell id="model5" value="5. Source Credibility Scorer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="575" y="580" width="450" height="200" as="geometry" />
        </mxCell>
        <mxCell id="model5-details" value="Method: XGBoost + time-decay weighting&#xa;&#xa;Metrics:&#xa;• AUC-ROC: 0.88&#xa;• Mean Absolute Error: 0.12&#xa;&#xa;Features checked:&#xa;• Historical accuracy   • Follower count / post count&#xa;• Post frequency       • Verification and trust status" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;spacing=4;" vertex="1" parent="1">
